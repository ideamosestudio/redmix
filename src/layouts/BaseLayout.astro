---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import FloatingWhatsApp from '../components/FloatingWhatsApp.astro';
import '@fontsource/roboto/latin-300.css';
import '@fontsource/roboto/latin-400.css';
import '@fontsource/montserrat/latin-500.css';
import '@fontsource/montserrat/latin-600.css';
import '@fontsource/montserrat/latin-700.css';
import '@fontsource/barlow-semi-condensed/latin-600.css';
import '@fontsource/barlow-semi-condensed/latin-700.css';
import displayFont from '@fontsource/barlow-semi-condensed/files/barlow-semi-condensed-latin-700-normal.woff2?url';
import uiFont from '@fontsource/montserrat/files/montserrat-latin-600-normal.woff2?url';
import bodyFont from '@fontsource/roboto/files/roboto-latin-300-normal.woff2?url';
import labelFont from '@fontsource/montserrat/files/montserrat-latin-500-normal.woff2?url';
import '../styles.css';

interface Props {
  title: string;
  noindex?: boolean;
  description: string;
  schema?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, schema, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname.replace(/\/?$/, '/'), Astro.site);
const root = import.meta.env.BASE_URL.replace(/\/$/, '');
const socialImage = new URL(`${root}/images/redmix-social-obra.jpg`, Astro.site);
const brandLogo = new URL(`${root}/images/redmix-logo.webp`, Astro.site);
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': ['LocalBusiness', 'Organization'],
  '@id': new URL(`${root}/#organization`, Astro.site).href,
  name: 'REDMIX Hormigonera',
  logo: brandLogo.href,
  image: socialImage.href,
  url: new URL(import.meta.env.BASE_URL, Astro.site).href,
  email: ['info@redmix.com.ar', 'adm@redmix.com.ar'],
  telephone: ['+54 9 11 3824 5680', '+54 9 11 3358 3377'],
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Ruta Provincial 16 3297',
    addressLocality: 'Longchamps',
    addressRegion: 'Provincia de Buenos Aires',
    addressCountry: 'AR',
  },
};
const pageSchema = { '@context': 'https://schema.org', '@type': Astro.url.pathname.includes('contacto') ? 'ContactPage' : Astro.url.pathname.includes('quienes-somos') ? 'AboutPage' : 'WebPage', '@id': canonical.href + '#webpage', url: canonical.href, name: title, description, inLanguage: 'es-AR', about: { '@id': organizationSchema['@id'] } };
const schemas = [organizationSchema, pageSchema, ...(Array.isArray(schema) ? schema : schema ? [schema] : [])];
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="UTF-8" />
    <link rel="preload" as="font" type="font/woff2" href={displayFont} crossorigin="anonymous" />
    <link rel="preload" as="font" type="font/woff2" href={uiFont} crossorigin="anonymous" />
    {Astro.url.pathname.replace(/\/$/, "") === root && <><link rel="preload" as="image" href={`${root}/images/back-002-760.webp`} media="(max-width: 767px)" fetchpriority="high" /><link rel="preload" as="image" href={`${root}/images/back-002-1920.webp`} media="(min-width: 768px)" fetchpriority="high" /></>}
    <link rel="preload" as="font" type="font/woff2" href={bodyFont} crossorigin="anonymous" />
    <link rel="preload" as="font" type="font/woff2" href={labelFont} crossorigin="anonymous" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <link rel="alternate" type="text/plain" href={`${root}/llms.txt`} title="Información de REDMIX para asistentes" />
    <meta name="theme-color" content="#111214" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href={`${root}/favicon.png`} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:site_name" content="REDMIX Hormigonera" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content="Camión hormigonero rojo y blanco en una obra de hormigón" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/jpeg" />
    <meta name="twitter:image:alt" content="Camión hormigonero rojo y blanco en una obra de hormigón" />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(schemas).replace(/</g, '\\u003c')} />
  </head>
  <body id="page-top">
    <Navbar />
    <slot />
    <FloatingWhatsApp />
    <Footer />
    <script>
      import '../site.js';
    </script>
  </body>
</html>
