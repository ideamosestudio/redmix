---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import FloatingWhatsApp from '../components/FloatingWhatsApp.astro';
import '@fontsource/roboto/latin-300.css';
import '@fontsource/roboto/latin-400.css';
import '@fontsource/montserrat/latin-500.css';
import '@fontsource/montserrat/latin-600.css';
import '@fontsource/montserrat/latin-700.css';
import '@fontsource/barlow-semi-condensed/latin-600.css';
import '@fontsource/barlow-semi-condensed/latin-700.css';
import displayFont from '@fontsource/barlow-semi-condensed/files/barlow-semi-condensed-latin-700-normal.woff2?url';
import bodyFont from '@fontsource/roboto/files/roboto-latin-300-normal.woff2?url';
import '../styles.css';

interface Props {
  title: string;
  noindex?: boolean;
  description: string;
  schema?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, schema, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname.replace(/\/?$/, '/'), Astro.site);
const root = import.meta.env.BASE_URL.replace(/\/$/, '');
const socialImage = new URL(`${root}/images/redmix-social-obra.jpg`, Astro.site);
const brandLogo = new URL(`${root}/images/redmix-logo.webp`, Astro.site);
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': ['LocalBusiness', 'Organization'],
  '@id': new URL(`${root}/#organization`, Astro.site).href,
  name: 'REDMIX Hormigonera',
  alternateName: 'REDMIX',
  description: 'Hormigonera en Longchamps: hormigón elaborado, acarreo de bomba y bombeo de hormigón. Consultá cobertura y disponibilidad para tu obra.',
  logo: brandLogo.href,
  image: socialImage.href,
  url: new URL(import.meta.env.BASE_URL, Astro.site).href,
  email: ['info@redmix.com.ar', 'adm@redmix.com.ar'],
  telephone: ['+54 9 11 3824 5680', '+54 9 11 3358 3377'],
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Ruta Provincial 16 3297',
    addressLocality: 'Longchamps',
    addressRegion: 'Provincia de Buenos Aires',
    addressCountry: 'AR',
  },
};
const pageSchema = { '@context': 'https://schema.org', '@type': Astro.url.pathname.includes('contacto') ? 'ContactPage' : Astro.url.pathname.includes('quienes-somos') ? 'AboutPage' : 'WebPage', '@id': canonical.href + '#webpage', url: canonical.href, name: title, description, inLanguage: 'es-AR', about: { '@id': organizationSchema['@id'] } };
const websiteSchema = { '@context': 'https://schema.org', '@type': 'WebSite', '@id': new URL('/#website', Astro.site).href, url: Astro.site?.href, name: 'REDMIX Hormigonera', inLanguage: 'es-AR', publisher: { '@id': organizationSchema['@id'] } };
const serviceNames: Record<string, string> = { 'hormigon-elaborado': 'Hormigón elaborado', 'acarreo-bomba': 'Acarreo de bomba', 'bombeo-hormigon': 'Bombeo de hormigón', contacto: 'Contacto', 'quienes-somos': 'Quiénes somos' };
const pageName = serviceNames[Astro.url.pathname.split('/').filter(Boolean).at(-1) ?? ''];
const breadcrumbs = pageName && !noindex ? [{ '@context': 'https://schema.org', '@type': 'BreadcrumbList', '@id': canonical.href + '#breadcrumb', itemListElement: [
  { '@type': 'ListItem', position: 1, name: 'Inicio', item: new URL(import.meta.env.BASE_URL, Astro.site).href },
  { '@type': 'ListItem', position: 2, name: pageName, item: canonical.href },
] }] : [];
const schemas = [organizationSchema, websiteSchema, { ...pageSchema, isPartOf: { '@id': websiteSchema['@id'] } }, ...breadcrumbs, ...(Array.isArray(schema) ? schema : schema ? [schema] : [])];
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="UTF-8" />
    <!-- The viewport must precede media-dependent preloads to avoid desktop downloads on phones. -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preload" as="font" type="font/woff2" href={displayFont} crossorigin="anonymous" />
    {Astro.url.pathname.replace(/\/$/, "") === root && <><link rel="preload" as="image" type="image/avif" href={`${root}/images/back-002-760.avif`} media="(max-width: 767px)" fetchpriority="high" /><link rel="preload" as="image" type="image/avif" href={`${root}/images/back-002-1920.avif`} media="(min-width: 768px)" fetchpriority="high" /></>}
    <link rel="preload" as="font" type="font/woff2" href={bodyFont} crossorigin="anonymous" />
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <link rel="alternate" type="text/plain" href={`${root}/llms.txt`} title="Información de REDMIX para asistentes" />
    <meta name="theme-color" content="#111214" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href={`${root}/favicon.png`} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:site_name" content="REDMIX Hormigonera" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content="Camión hormigonero rojo y blanco en una obra de hormigón" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/jpeg" />
    <meta name="twitter:image:alt" content="Camión hormigonero rojo y blanco en una obra de hormigón" />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(schemas).replace(/</g, '\\u003c')} />
  </head>
  <body id="page-top">
    <Navbar />
    <slot />
    <FloatingWhatsApp />
    <Footer />
    <script>
      import '../site.js';
    </script>
  </body>
</html>
