---
import BaseLayout from '../layouts/BaseLayout.astro';
import ImageReveal from '../components/ImageReveal.astro';
import ServiceCard from '../components/ServiceCard.astro';
import ContactInfo from '../components/ContactInfo.astro';
import FinalCTA from '../components/FinalCTA.astro';
import WhatsAppCTA from '../components/WhatsAppCTA.astro';
import empresaImage from '../assets/redmix/empresa/planta-operacion.png';
import hormigonImage from '../assets/redmix/hormigon/hormigon-descarga.png';
import acarreoImage from '../assets/redmix/acarreo/camion-bomba.png';
import bombeoImage from '../assets/redmix/bombeo/bombeo-obra.png';
const root = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<BaseLayout title="Quiénes somos | REDMIX Hormigonera" description="Conocé REDMIX Hormigonera, una empresa joven con más de 20 años de experiencia en el rubro de la construcción.">
  <main class="inner-page">
    <section class="about-hero page-hero">
      <div class="page-hero__copy" data-reveal>
        <p class="eyebrow"><span></span>QUIÉNES SOMOS</p>
        <h1>REDMIX<br />HORMIGONERA</h1>
        <p class="page-hero__lead">Una empresa joven con más de 20 años de experiencia en el rubro.</p>
        <WhatsAppCTA label="HABLAR CON REDMIX" />
      </div>
      <ImageReveal src={empresaImage} alt="Actividad en una operación de hormigón elaborado" eager motion="horizontal" class="page-hero__image" />
    </section>

    <section class="about-copy section-shell">
      <div data-reveal><p class="section-code">01 / REDMIX</p><h2>EXPERIENCIA QUE ACOMPAÑA <em>CADA PROYECTO.</em></h2></div>
      <div data-reveal>
        <p>REDMIX combina una estructura dinámica con la experiencia acumulada durante más de dos décadas dentro del sector de la construcción.</p>
        <p>Desde Longchamps, Provincia de Buenos Aires, brindamos soluciones vinculadas al hormigón elaborado y servicios complementarios para obras.</p>
      </div>
    </section>

    <section class="services-section section-shell" aria-labelledby="about-services-title">
      <div class="section-heading" data-reveal><p class="section-code">02 / SERVICIOS</p><h2 id="about-services-title">SOLUCIONES PARA <em>TU OBRA.</em></h2></div>
      <div class="services-grid" data-stagger>
        <ServiceCard index="01" title="HORMIGÓN ELABORADO" description="Suministro de hormigón elaborado para diferentes tipos de obras y necesidades de construcción." href={`${root}/servicios/hormigon-elaborado`} image={hormigonImage} imageAlt="Descarga de hormigón elaborado" />
        <ServiceCard index="02" title="ACARREO DE BOMBA" description="Traslado y puesta a disposición del equipo de bombeo necesario para realizar el trabajo en obra." href={`${root}/servicios/acarreo-bomba`} image={acarreoImage} imageAlt="Camión bomba en obra" />
        <ServiceCard index="03" title="BOMBEO DE HORMIGÓN" description="Bombeo por volumen para facilitar la descarga y colocación del material dentro de la obra." href={`${root}/servicios/bombeo-hormigon`} image={bombeoImage} imageAlt="Bombeo de hormigón en obra" />
      </div>
    </section>

    <section class="contact-strip section-shell" data-reveal>
      <div><p class="section-code">03 / CONTACTO</p><h2>ESTAMOS EN <em>LONGCHAMPS.</em></h2></div>
      <ContactInfo />
    </section>
    <FinalCTA title="HABLEMOS DE TU OBRA" label="HABLAR CON REDMIX" />
  </main>
</BaseLayout>
