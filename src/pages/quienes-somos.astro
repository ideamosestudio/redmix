---
import BaseLayout from '../layouts/BaseLayout.astro';
import ImageReveal from '../components/ImageReveal.astro';
import ServiceCard from '../components/ServiceCard.astro';
import FinalCTA from '../components/FinalCTA.astro';
import WhatsAppCTA from '../components/WhatsAppCTA.astro';
import empresaImage from '../assets/redmix/empresa/planta-operacion.png';
import hormigonImage from '../assets/redmix/hormigon/hormigon-descarga.png';
import acarreoImage from '../assets/redmix/acarreo/camion-bomba.png';
import bombeoImage from '../assets/redmix/bombeo/bombeo-obra.png';
const root = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<BaseLayout title="Quiénes somos | REDMIX Hormigonera" description="Conocé REDMIX Hormigonera, una empresa joven con más de 20 años de experiencia en el rubro de la construcción.">
  <main class="inner-page about-page">
    <section class="about-hero page-hero">
      <div class="page-hero__copy" data-reveal>
        <p class="eyebrow"><span></span>REDMIX · LONGCHAMPS</p>
        <h1><span>EXPERIENCIA</span><span>PARA <em>CONSTRUIR.</em></span></h1>
        <p class="page-hero__lead">Somos REDMIX. Hormigón elaborado, acarreo y bombeo, con la experiencia del rubro puesta al servicio de tu obra.</p>
        <WhatsAppCTA label="HABLAR CON REDMIX" />
      </div>
      <ImageReveal src={empresaImage} alt="Operación de hormigón elaborado" eager class="about-hero__image" label="" />
    </section>

    <section class="about-copy section-shell">
      <div data-reveal><p class="section-code">REDMIX</p><h2>TU OBRA.<br /><em>UN MISMO PROVEEDOR.</em></h2></div>
      <div data-reveal>
        <p>REDMIX combina una estructura dinámica con la experiencia acumulada durante más de dos décadas dentro del sector de la construcción.</p>
        <p>Desde Longchamps, Provincia de Buenos Aires, brindamos soluciones vinculadas al hormigón elaborado y servicios complementarios para obras.</p>
        <p class="about-origin">LONGCHAMPS · BUENOS AIRES</p>
      </div>
    </section>

    <section class="experience-section experience-section--statement section-shell" aria-labelledby="experience-title">
      <div class="experience-section__copy" data-reveal>
        <p class="section-code">EXPERIENCIA</p>
        <h2 id="experience-title">UNA MIRADA JOVEN.<br /><em>EXPERIENCIA EN OBRA.</em></h2>
        <p>Más de dos décadas de experiencia en el rubro respaldan nuestro trabajo. Unimos ese conocimiento con una estructura dinámica para acompañar cada proyecto.</p>
      </div>
      <div class="experience-counter" data-reveal aria-label="Más de veinte años de experiencia">
        <strong data-experience-counter aria-hidden="true">+20</strong>
        <span>AÑOS<br />DE EXPERIENCIA</span>
      </div>
    </section>

    <section class="services-section section-shell" aria-labelledby="about-services-title">
      <div class="section-heading section-heading--row services-heading" data-reveal><div><p class="section-code">SERVICIOS</p><h2 id="about-services-title">SOLUCIONES PARA <em>TU OBRA.</em></h2></div><p>Suministro, traslado y colocación. Conocé cómo podemos acompañarte.</p></div>
      <div class="services-grid" data-stagger>
        <ServiceCard title="HORMIGÓN ELABORADO" description="Hormigón elaborado para las necesidades de tu obra." href={`${root}/servicios/hormigon-elaborado`} image={hormigonImage} imageAlt="Descarga de hormigón elaborado" />
        <ServiceCard title="ACARREO DE BOMBA" description="Traslado del equipo de bombeo hasta tu obra." href={`${root}/servicios/acarreo-bomba`} image={acarreoImage} imageAlt="Camión bomba en obra" />
        <ServiceCard title="BOMBEO DE HORMIGÓN" description="Descarga y colocación del hormigón mediante bombeo." href={`${root}/servicios/bombeo-hormigon`} image={bombeoImage} imageAlt="Bombeo de hormigón en obra" />
      </div>
    </section>

    <FinalCTA title="HABLEMOS DE TU OBRA" label="HABLAR CON REDMIX" />
  </main>
</BaseLayout>
