---
import BaseLayout from '../layouts/BaseLayout.astro';
import Portada from '../components/propuestas/Portada.astro';
import Selector from '../components/propuestas/Selector.astro';
import '../styles/propuestas.css';
import ImageReveal from '../components/ImageReveal.astro';
import ServiceCard from '../components/ServiceCard.astro';
import ProductCard from '../components/ProductCard.astro';
import WhatsAppCTA from '../components/WhatsAppCTA.astro';
import FinalCTA from '../components/FinalCTA.astro';
import ProcessFlow from '../components/ProcessFlow.astro';
import ServiceMarquee from '../components/ServiceMarquee.astro';
import introImage from '../assets/redmix/home/mixer-descarga.png';
import hormigonImage from '../assets/redmix/hormigon/hormigon-descarga.png';
import acarreoImage from '../assets/redmix/acarreo/camion-bomba.png';
import bombeoImage from '../assets/redmix/bombeo/bombeo-obra.png';
import h17Image from '../assets/redmix/products/h17.png';
import h21Image from '../assets/redmix/products/h21.png';
import h25Image from '../assets/redmix/products/h25.png';
import h30Image from '../assets/redmix/products/h30.png';
import h30pImage from '../assets/redmix/products/h30-proyectable.png';

const root = import.meta.env.BASE_URL.replace(/\/$/, '');
const products = [
  { name: 'HORMIGÓN H17', image: h17Image, alt: 'Imagen editorial representativa de hormigón fresco en obra' },
  { name: 'HORMIGÓN H21', image: h21Image, alt: 'Imagen editorial representativa de hormigón en encofrado' },
  { name: 'HORMIGÓN H25', image: h25Image, alt: 'Imagen editorial representativa de hormigón y armaduras' },
  { name: 'HORMIGÓN H30', image: h30Image, alt: 'Imagen editorial representativa de estructura de hormigón' },
  { name: 'HORMIGÓN H30 PROYECTABLE', image: h30pImage, alt: 'Imagen editorial representativa de hormigón proyectado' },
];
---

<BaseLayout title="REDMIX Hormigonera | Hormigón elaborado, acarreo y bombeo" description="Hormigón elaborado, acarreo de bomba y bombeo de hormigón para obras. Consultá a REDMIX Hormigonera en Longchamps.">
  <Portada variante="camion"/>
  <Selector active="camion"/>

  <main class="home-content">

    <section class="services-section section-shell" id="servicios" aria-labelledby="services-title">
      <div class="section-heading section-heading--row section-heading--centered" data-reveal>
        <div><p class="section-code">SERVICIOS</p><h2 id="services-title">NUESTROS <em>SERVICIOS.</em></h2></div>
        <p>Soluciones vinculadas al suministro, traslado y colocación del hormigón para tu obra.</p>
      </div>
      <div class="services-grid" data-stagger>
        <ServiceCard title="VENTA DE HORMIGÓN ELABORADO" description="Suministro de hormigón elaborado para diferentes tipos de obras y necesidades de construcción." href={`${root}/servicios/hormigon-elaborado`} image={hormigonImage} imageAlt="Hormigón elaborado descargándose en obra" />
        <ServiceCard title="ACARREO DE BOMBA" description="Servicio de traslado y puesta a disposición del equipo de bombeo necesario para realizar el trabajo en obra." href={`${root}/servicios/acarreo-bomba`} image={acarreoImage} imageAlt="Camión bomba posicionado en una obra" />
        <ServiceCard title="SERVICIO DE BOMBEO" description="Bombeo de hormigón calculado por volumen, para facilitar la descarga y colocación del material dentro de la obra." href={`${root}/servicios/bombeo-hormigon`} image={bombeoImage} imageAlt="Manguera realizando bombeo de hormigón" />
      </div>
    </section>

    <ServiceMarquee />

    <section class="products-section section-shell" aria-labelledby="products-title">
      <div class="section-heading section-heading--row section-heading--centered" data-reveal>
        <div><p class="section-code">PRODUCTOS</p><h2 id="products-title">PRODUCTOS <em>DE LÍNEA.</em></h2></div>
        <div class="section-heading__aside"><p>Consultanos para conocer la alternativa adecuada para tu obra.</p></div>
      </div>
      <div class="products-grid" data-stagger>
        {products.map((product) => <ProductCard name={product.name} image={product.image} imageAlt={product.alt} />)}
      </div>
      <div class="section-end-cta" data-reveal><WhatsAppCTA label="CONSULTAR POR HORMIGÓN" /></div>
    </section>

    <section class="solutions-section" aria-labelledby="intro-title">
    <div class="intro-section section-shell" aria-labelledby="intro-title">
      <div class="section-heading" data-reveal>
        <p class="section-code">REDMIX</p>
        <h2 id="intro-title">SOLUCIONES EN<br /><em>HORMIGÓN</em><br />PARA TU OBRA</h2>
      </div>
      <div class="intro-section__body" data-reveal>
        <p>Hormigón elaborado, acarreo y bombeo para tu obra. Coordiná el suministro y la colocación con un mismo proveedor.</p>
        <WhatsAppCTA label="SOLICITAR PRESUPUESTO" />
      </div>
      <ImageReveal src={introImage} alt="Camión mixer descargando hormigón fresco en una obra" class="intro-section__image" label="HORMIGÓN EN OBRA" />
    </div>
      <ProcessFlow integrated />
    </section>

    <FinalCTA />
  </main>
</BaseLayout>
