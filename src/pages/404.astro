---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Página no encontrada | REDMIX" description="La página que buscás no está disponible. Volvé al inicio o contactá a REDMIX para consultar por tu obra." noindex>
  <main class="inner-page">
    <section class="section-shell" style="padding-block: clamp(5rem, 15vh, 10rem)">
      <p class="section-code">ERROR 404</p>
      <h1>ESTA PÁGINA <em>NO ESTÁ DISPONIBLE.</em></h1>
      <p>Podés volver al inicio para conocer nuestros servicios o contactarnos para consultar por tu obra.</p>
      <p><a href="/">Volver al inicio →</a></p>
      <p><a href="/contacto/">Contactar a REDMIX →</a></p>
    </section>
  </main>
</BaseLayout>
