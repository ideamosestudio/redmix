---
import Portada from '../../components/propuestas/Portada.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Selector from '../../components/propuestas/Selector.astro';
import '../../styles/propuestas.css';
export function getStaticPaths() { return ['camion','tambor','descarga'].map(variante => ({params:{variante}})); }
const { variante } = Astro.params;
const root = import.meta.env.BASE_URL.replace(/\/$/, '');
const details = {
 camion: {name:'Camión cinematográfico',eyebrow:'POTENCIA PARA LO QUE VIENE.',note:'Propuesta 01 · Escena conceptual animada, no representa la flota real.'},
 tambor: {name:'Tambor en movimiento',eyebrow:'EL MOVIMIENTO QUE CONSTRUYE.',note:'Propuesta 03 · Escena 3D interactiva. Mové el cursor para explorar.'},
 descarga: {name:'Hormigón en acción',eyebrow:'DONDE EMPIEZA TU PRÓXIMA OBRA.',note:'Propuesta 04 · Video conceptual generado con Magnific.'}
}[variante];
---
<BaseLayout title={details.name + ' | Propuestas REDMIX'} description="Comparación de propuestas visuales para la portada de REDMIX." noindex>
  <Selector active={variante}/>
  <main class:list={['concept-page', 'concept-page--' + variante]}>
    <Portada variante={variante}/>
    <aside class="concept-review"><div><p>EXPLORACIÓN VISUAL / REDMIX</p><h2>{details.name}</h2><span>{details.note}</span></div><a href={root + '/propuestas/'}>Ver todas las portadas ↗</a></aside>
  </main>
</BaseLayout>
