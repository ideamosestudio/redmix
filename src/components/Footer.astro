---
import ArrowIcon from './ArrowIcon.astro';
const root = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (path = '/') => root + path;
---
<footer class="site-footer site-footer--editorial">
  <div class="site-footer__brand">
    <a href={href('/')} aria-label="REDMIX — Inicio"><img src={root + '/images/redmix-logo.webp'} width="565" height="189" alt="REDMIX Hormigonera" loading="lazy" /></a>
    <p class="footer-editorial-statement">CONSTRUÍ<br />LO QUE <em>VIENE.</em></p>
    <span class="footer-orbit" aria-hidden="true"><svg class="footer-orbit__ring" viewBox="0 0 160 160"><defs><path id="footer-orbit-path" d="M80,80 m-62,0 a62,62 0 1,1 124,0 a62,62 0 1,1 -124,0" /></defs><text><textPath href="#footer-orbit-path" textLength="389">REDMIX · HORMIGÓN EN MOVIMIENTO · </textPath></text></svg><img src={root + '/images/redmix-symbol.webp'} width="64" height="66" alt="" loading="lazy" /></span>
    <p class="footer-editorial-location">Longchamps · Buenos Aires</p>
  </div>
  <nav class="footer-editorial-nav" aria-label="Navegación del pie de página">
    <p class="footer-label footer-nav-label">Explorá REDMIX</p>
    <button class="footer-nav-toggle" type="button" aria-expanded="false" aria-controls="footer-nav-links" hidden>Explorá REDMIX <span aria-hidden="true">+</span></button>
    <div class="footer-nav-links" id="footer-nav-links">
    <a href={href('/')}><span>Inicio</span><ArrowIcon class="footer-item-arrow" /></a>
    <a href={href('/quienes-somos')}><span>Quiénes somos</span><ArrowIcon class="footer-item-arrow" /></a>
    <a href={href('/contacto')}><span>Contacto</span><ArrowIcon class="footer-item-arrow" /></a>
    </div>
    <button class="footer-nav-toggle footer-services-toggle" type="button" aria-expanded="false" aria-controls="footer-service-links" hidden>Servicios <span aria-hidden="true">+</span></button>
    <div class="footer-editorial-services" id="footer-service-links">
      <p class="footer-label footer-services-label">Servicios</p>
      <a href={href('/servicios/hormigon-elaborado')}><span>Hormigón elaborado</span><ArrowIcon class="footer-item-arrow" /></a>
      <a href={href('/servicios/acarreo-bomba')}><span>Acarreo de bomba</span><ArrowIcon class="footer-item-arrow" /></a>
      <a href={href('/servicios/bombeo-hormigon')}><span>Bombeo de hormigón</span><ArrowIcon class="footer-item-arrow" /></a>
    </div>
  </nav>
  <div class="site-footer__contact">
    <h2 class="footer-label footer-contact-heading">Hablemos de <em>tu obra</em></h2>
    <div class="site-footer__contact-group">
      <a class="footer-email-primary" href="mailto:info@redmix.com.ar">info@redmix.com.ar</a>
      <a class="footer-email-secondary" href="mailto:adm@redmix.com.ar">adm@redmix.com.ar</a>
    </div>
    <div class="site-footer__contact-group">
      <a href="tel:+5491138245680">+54 9 11 3824 5680</a>
      <a href="tel:+5491133583377">+54 9 11 3358 3377</a>
    </div>
    <address>Ruta Provincial 16 3297<br />Longchamps, Provincia de Buenos Aires</address>
    <a class="footer-contact-link" href="https://wa.me/5491138245680" target="_blank" rel="noopener noreferrer">CONVERSAR POR WHATSAPP <ArrowIcon /></a>
  </div>
  <div class="site-footer__legal"><span>© {new Date().getFullYear()} REDMIX HORMIGONERA</span><a class="footer-credit" href="https://ideamos.com.ar/" target="_blank" rel="noopener noreferrer" aria-label="Desarrollado por Ideamos. Visitar Ideamos"><span>Desarrollado por</span><img src={root + '/images/ideamos-light.webp'} width="870" height="213" alt="Ideamos" loading="lazy" decoding="async" /></a></div>
</footer>

<script>
 const nav=document.querySelector<HTMLElement>('.footer-editorial-nav');
 const mobile=window.matchMedia('(max-width:767px)');
 nav?.querySelectorAll<HTMLButtonElement>('.footer-nav-toggle').forEach(toggle=>{
  const links=document.getElementById(toggle.getAttribute('aria-controls') || '');
  if(!links) return;
  const sync=()=>{toggle.hidden=!mobile.matches;links.hidden=mobile.matches;toggle.setAttribute('aria-expanded',String(!mobile.matches));nav.classList.toggle('is-collapsible',mobile.matches);};
  toggle.addEventListener('click',()=>{const expanded=toggle.getAttribute('aria-expanded')==='true';toggle.setAttribute('aria-expanded',String(!expanded));links.hidden=expanded;});
  mobile.addEventListener('change',sync);sync();
 });
</script>
