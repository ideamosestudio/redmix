---
import ArrowIcon from './ArrowIcon.astro';
const root = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (path = '/') => root + path;
---
<footer class="site-footer site-footer--editorial">
  <div class="site-footer__brand">
    <a href={href('/')} aria-label="REDMIX — Inicio"><img src={root + '/images/redmix-logo.png'} width="565" height="189" alt="REDMIX Hormigonera" loading="lazy" /></a>
    <p class="footer-editorial-statement">CONSTRUÍ<br />LO QUE <em>VIENE.</em></p>
    <p class="footer-editorial-location">Longchamps · Buenos Aires</p>
  </div>
  <nav class="footer-editorial-nav" aria-label="Navegación del pie de página">
    <p class="footer-label">Explorá REDMIX</p>
    <a href={href('/')}>Inicio</a>
    <a href={href('/quienes-somos')}>Quiénes somos</a>
    <a href={href('/contacto')}>Contacto</a>
    <div class="footer-editorial-services">
      <a href={href('/servicios/hormigon-elaborado')}>Hormigón elaborado</a>
      <a href={href('/servicios/acarreo-bomba')}>Acarreo de bomba</a>
      <a href={href('/servicios/bombeo-hormigon')}>Bombeo de hormigón</a>
    </div>
  </nav>
  <div class="site-footer__contact">
    <p class="footer-label">Hablemos de tu obra</p>
    <div class="site-footer__contact-group">
      <a href="mailto:info@redmix.com.ar">info@redmix.com.ar</a>
      <a href="mailto:adm@redmix.com.ar">adm@redmix.com.ar</a>
    </div>
    <div class="site-footer__contact-group">
      <a href="tel:+5491138245680">+54 9 11 3824 5680</a>
      <a href="tel:+5491133583377">+54 9 11 3358 3377</a>
    </div>
    <address>Ruta Provincial 16 3297<br />Longchamps, Provincia de Buenos Aires</address>
    <a class="footer-contact-link" href="https://wa.me/5491138245680" target="_blank" rel="noopener noreferrer">CONVERSAR POR WHATSAPP <ArrowIcon /></a>
  </div>
  <div class="site-footer__legal"><span>© {new Date().getFullYear()} REDMIX HORMIGONERA</span><a class="footer-top" href="#page-top">Volver arriba <ArrowIcon /></a></div>
</footer>
