---
const { variant = 'actual' } = Astro.props;
const root = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<div class:list={['industrial-backdrop', 'industrial-backdrop--' + variant]} aria-hidden="true">
 <img src={root + '/propuestas/arquitectura-magnific.webp'} alt="" width="1920" height="1080" decoding="async"/>
</div>
<style>
 .industrial-backdrop { position: absolute; inset: 0; overflow: hidden; pointer-events: none; background: #090b0e; }
 img { width: 100%; height: 100%; object-fit: cover; object-position: center; opacity: .85; filter: saturate(.52) contrast(1.12); }
 .industrial-backdrop::after { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg,#080b10db,#080b1080 42%,#080b100d 80%),linear-gradient(0deg,#080b10a6,transparent 35%); }
 .industrial-backdrop--camion img { object-position: 65% center; filter: saturate(.38) contrast(1.1); opacity: .8; }
 .industrial-backdrop--tambor img { object-position: 80% center; filter: grayscale(.85) contrast(1.12); opacity: .7; }
 .industrial-backdrop--tambor::after { background: radial-gradient(ellipse at 76% 55%,#fa321925,transparent 55%),linear-gradient(90deg,#080b10eb,#080b1066 55%,#080b1020),linear-gradient(0deg,#080b10aa,transparent 35%); }
 @media(max-width: 1023px) { img { object-position: 65% center; } .industrial-backdrop::after { background: linear-gradient(180deg,#080b10bb,#080b1066 45%,#080b1022 65%,#080b10bb); } }
</style>
