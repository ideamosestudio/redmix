---
import '../styles.css';
---

<header class="site-header">
  <a class="brand" href="#inicio" aria-label="REDMIX, inicio">
    <span class="brand__mark" aria-hidden="true">
      <i></i><i></i><i></i><i></i><i></i>
    </span>
    <span>REDMIX</span>
  </a>
  <span class="header-note">HORMIGONERA</span>
  <a class="header-link" href="#contacto">CONTACTO <span aria-hidden="true">↗</span></a>
</header>

<main>
  <section class="hero" id="inicio" aria-labelledby="hero-title">
    <div class="hero__sticky">
      <canvas class="hero__canvas" aria-hidden="true"></canvas>
      <div class="hero__noise" aria-hidden="true"></div>

      <div class="hero__eyebrow" aria-hidden="true">
        <span>01</span>
        <span>INDUSTRIA / CONSTRUCCIÓN</span>
      </div>

      <div class="hero__intro" data-hero-intro>
        <p class="overline">HORMIGÓN · TECNOLOGÍA · PRECISIÓN</p>
        <h1 id="hero-title">REDMIX <span>HORMIGONERA</span></h1>
        <p>Soluciones para la construcción</p>
      </div>

      <div class="hero__statement" data-hero-statement>
        <p class="overline">NUESTRA FORMA DE HACER</p>
        <h2>SOLUCIONES QUE<br />CONSTRUYEN <em>FUTURO</em></h2>
        <p class="statement-copy">
          Desarrollamos soluciones de hormigón con precisión, capacidad y una mirada puesta en lo que viene.
        </p>
        <a class="cta" href="#contacto">
          <span>CONOCER SOLUCIONES</span>
          <span class="cta__icon" aria-hidden="true">↗</span>
        </a>
      </div>

      <div class="scroll-cue" aria-hidden="true">
        <span>SCROLL PARA EXPLORAR</span>
        <span class="scroll-cue__line"><i data-progress></i></span>
      </div>
    </div>
  </section>

  <section class="after-hero" id="contacto" aria-label="Fin del hero">
    <div>
      <p class="overline">CONTENIDO EN DESARROLLO</p>
      <h2>EL HERO<br />TERMINA ACÁ.</h2>
    </div>
    <p>
      Esta sección temporal permite comprobar la salida natural del canvas sticky antes de avanzar con el resto del sitio.
    </p>
  </section>
</main>

<script>
  import '../main.js';
</script>
