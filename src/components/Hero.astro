---
import WhatsAppCTA from './WhatsAppCTA.astro';
const root = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<div class="hero-root">
  <section class="hero" id="inicio" aria-labelledby="hero-title">
    <div class="hero-sticky">
      <div class="concrete-field" aria-hidden="true"></div>
      <div class="technical-grid" aria-hidden="true"></div>
      <div class="ambient-glow" aria-hidden="true"></div>
      <div class="scanline" aria-hidden="true"></div>

      <svg class="blueprint blueprint--top" viewBox="0 0 600 90" aria-hidden="true">
        <path d="M1 75H195M405 75H599M200 75H400M200 68V82M400 68V82" />
        <path class="blueprint__dash" d="M220 32H380" />
        <circle cx="300" cy="32" r="10" /><path d="M290 32H310M300 22V42" />
      </svg>

      <div class="measure measure--left" aria-hidden="true"><span>± 0.000</span><i></i><span>EJE A.01</span></div>
      <div class="measure measure--right" aria-hidden="true"><span>COTA 06.40</span><i></i><span>RMX / 01</span></div>

      <div class="hero-copy" data-copy>
        <p class="eyebrow"><span></span>HORMIGÓN ELABORADO PARA OBRAS</p>
        <h1 id="hero-title">
          <span>VENTA DE HORMIGÓN ELABORADO</span>
          <span class="title-outline">ALQUILER DE BOMBA</span>
        </h1>
        <div class="hero-intro">
          <span class="intro-index">01—03</span>
          <p>Hormigón elaborado, acarreo y bombeo para obras y proyectos de construcción. <a href="https://wa.me/5491138245680?text=Hola%20Redmix%2C%20quisiera%20solicitar%20un%20presupuesto." target="_blank" rel="noopener noreferrer">Contactanos hoy y charlemos de tu proyecto.</a></p>
        </div>
        <div class="hero-actions">
          <WhatsAppCTA label="PEDIR PRESUPUESTO" />
          <a class="technical-cta" href={`${root}/quienes-somos`}>
            <span>CONOCER REDMIX</span>
            <i class="tick tick--a"></i><i class="tick tick--b"></i><i class="tick tick--c"></i><i class="tick tick--d"></i>
          </a>
        </div>
      </div>

      <div class="hero-object" data-object-wrap>
        <div class="object-glow" aria-hidden="true"></div>
        <canvas class="hero-canvas" aria-hidden="true"></canvas>
        <div class="object-crosshair" aria-hidden="true"><i></i><i></i></div>
        <div class="object-tag object-tag--top" aria-hidden="true"><span>SISTEMA REDMIX</span><b>HORMIGÓN</b></div>
        <div class="object-tag object-tag--bottom" aria-hidden="true"><span>SERVICIOS</span><b>VENTA / ACARREO / BOMBEO</b></div>
      </div>

      <div class="hero-mobile-action">
        <WhatsAppCTA label="PEDIR PRESUPUESTO" />
      </div>

      <div class="hero-foot" aria-hidden="true">
        <div><span>SERVICIO 01</span><b>HORMIGÓN</b></div>
        <div><span>SERVICIO 02</span><b>ACARREO</b></div>
        <div><span>SERVICIO 03</span><b>BOMBEO</b></div>
        <p>DESLIZÁ PARA EXPLORAR <i data-progress></i></p>
      </div>
    </div>
  </section>

</div>

<script>
  import '../main.js';
</script>
