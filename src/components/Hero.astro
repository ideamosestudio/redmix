---
import WhatsAppCTA from './WhatsAppCTA.astro';
const root = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<div class="hero-root">
  <section class="hero hero--future" id="inicio" aria-labelledby="hero-title">
    <div class="hero-sticky">
      <div class="concrete-field" aria-hidden="true"></div>
      <div class="technical-grid" aria-hidden="true"></div>
      <div class="ambient-glow" aria-hidden="true"></div>
      <div class="scanline" aria-hidden="true"></div>

      <div class="hero-wordmark" aria-hidden="true">REDMIX</div>
      <div class="hero-copy" data-copy>
        <p class="eyebrow"><span></span>CONSTRUÍ LO QUE VIENE.</p>
        <h1 id="hero-title">
          <span>HORMIGÓN ELABORADO Y</span>
          <span class="title-outline">ALQUILER DE BOMBA</span>
        </h1>
        <div class="hero-intro">
          <p>Hormigón elaborado y servicio de bombeo para tu obra. Contanos qué necesitás y solicitá tu presupuesto.</p>
        </div>
        <div class="hero-actions">
          <WhatsAppCTA label="SOLICITAR PRESUPUESTO" />
          <a class="technical-cta" href={`${root}/quienes-somos`}>
            <span>CONOCER REDMIX</span>
            <i class="tick tick--a"></i><i class="tick tick--b"></i><i class="tick tick--c"></i><i class="tick tick--d"></i>
          </a>
        </div>
      </div>

      <div class="hero-object" data-object-wrap>
        <div class="object-glow" aria-hidden="true"></div>
        <div class="hero-orbits" aria-hidden="true"><i></i><i></i><i></i></div>
        <div class="hero-platform" aria-hidden="true"></div>
        <canvas class="hero-canvas" aria-hidden="true"></canvas>
      </div>
      <div class="hero-signature"><span><i></i> LONGCHAMPS, BUENOS AIRES</span><span>HORMIGÓN <b>/</b> ACARREO <b>/</b> BOMBEO</span></div>
    </div>
  </section>

</div>

<script>
  import '../main.js';
</script>
