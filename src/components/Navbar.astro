---
const root = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (path = '/') => `${root}${path}`;
const pathname = Astro.url.pathname.replace(root, '') || '/';
const current = (path: string) => path === '/' ? pathname === '/' : pathname.startsWith(path);
const whatsappUrl = 'https://wa.me/5491138245680?text=Hola%20Redmix%2C%20quisiera%20solicitar%20un%20presupuesto.';
---

<header class="nav-shell" data-navbar>
  <a class="nav-logo" href={href('/')} aria-label="REDMIX Hormigonera, inicio">
    <img src={`${root}/images/redmix-logo.png`} width="565" height="189" alt="REDMIX Hormigonera" />
  </a>

  <button class="nav-toggle" type="button" aria-label="Abrir navegación" aria-expanded="false" aria-controls="main-nav" data-menu-toggle>
    <span></span><span></span>
  </button>

  <nav class="nav-links" id="main-nav" aria-label="Navegación principal" data-menu>
    <a class:list={{ 'is-current': current('/quienes-somos') }} href={href('/quienes-somos')}><span>01</span>Quiénes somos</a>
    <div class:list={['nav-dropdown', { 'is-current': current('/servicios') }]}>
      <button type="button" aria-haspopup="true"><span>02</span>Servicios</button>
      <div class="nav-dropdown__panel">
        <a href={href('/servicios/hormigon-elaborado')}>Hormigón elaborado</a>
        <a href={href('/servicios/acarreo-bomba')}>Acarreo de bomba</a>
        <a href={href('/servicios/bombeo-hormigon')}>Bombeo de hormigón</a>
      </div>
    </div>
    <a class:list={{ 'is-current': current('/contacto') }} href={href('/contacto')}><span>03</span>Contacto</a>
    <a class="nav-budget nav-budget--mobile" href={whatsappUrl} target="_blank" rel="noopener noreferrer">SOLICITÁ PRESUPUESTO</a>
  </nav>

  <a class="nav-budget nav-budget--desktop" href={whatsappUrl} target="_blank" rel="noopener noreferrer"><i></i><span>SOLICITÁ PRESUPUESTO</span></a>
</header>
