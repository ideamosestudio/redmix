---
import ArrowIcon from '../ArrowIcon.astro';
import IndustrialBackdrop from '../IndustrialBackdrop.astro';
import WhatsAppCTA from '../WhatsAppCTA.astro';
import '../../styles/propuestas.css';
const { variante = 'camion' } = Astro.props;
const root = import.meta.env.BASE_URL.replace(/\/$/, '');
const eyebrow = {camion:'POTENCIA PARA LO QUE VIENE.',tambor:'EL MOVIMIENTO QUE CONSTRUYE.',descarga:'DONDE EMPIEZA TU PRÓXIMA OBRA.'}[variante];
---
<div class:list={['concept-page','concept-page--' + variante]}>
    <section class="concept-hero" aria-labelledby="concept-title" data-concept={variante}>
      <div class="concept-atmosphere" aria-hidden="true">{variante === 'tambor' && <IndustrialBackdrop variant={variante}/>}</div>
      {variante === 'camion' && <div class="truck-scene"><video data-concept-video muted loop playsinline preload="metadata" poster={root + '/propuestas/camion-obra.webp'} aria-label="Camión hormigonero estacionado en obra con el tambor girando"><source src={root + '/propuestas/camion-obra.mp4'} type="video/mp4"/></video><div class="truck-scene__shade"></div><span class="truck-wordmark" aria-hidden="true">REDMIX</span><div class="truck-callout"><span>HORMIGÓN EN MOVIMIENTO</span><i aria-hidden="true"></i></div></div>}
      {variante === 'tambor' && <div class="concept-drum"><div class="concept-drum__halo" aria-hidden="true"></div><canvas data-drum aria-label="Tambor rojo de hormigonera girando en tres dimensiones" role="img"></canvas><span class="concept-drum__label">MEZCLA EN MOVIMIENTO <i></i></span><p class="concept-fallback" hidden>La escena 3D no está disponible en este navegador.</p></div>}
      {variante === 'descarga' && <div class="concept-film"><video data-concept-video muted loop playsinline preload="metadata" poster={root + '/propuestas/descarga-magnific.jpg'} aria-label="Descarga de hormigón desde una hormigonera"><source src={root + '/propuestas/descarga-magnific.mp4'} type="video/mp4"/></video><div class="concept-film__shade"></div><span class="truck-wordmark" aria-hidden="true">REDMIX</span><div class="truck-callout"><span>HORMIGÓN EN ACCIÓN</span><i aria-hidden="true"></i></div></div>}
      <div class="concept-copy">
        <p class="concept-eyebrow"><i></i>{eyebrow}</p>
        <h1 id="concept-title"><span>HORMIGÓN ELABORADO<b class="hero-desktop-conjunction"> Y</b></span><span><b class="hero-mobile-conjunction">Y </b>ALQUILER DE BOMBA</span></h1>
        <p class="concept-intro"><span class="hero-desktop-description">Hormigón elaborado y servicio de bombeo para tu obra. Contanos qué necesitás y solicitá tu presupuesto.</span><span class="hero-mobile-description">Hormigón y bombeo para tu obra. Coordiná tu próximo proyecto con REDMIX.</span></p>
        <div class="concept-actions"><WhatsAppCTA label="SOLICITAR PRESUPUESTO"/><a class="technical-cta" href={root + '/quienes-somos'}><span>CONOCER REDMIX</span><ArrowIcon /></a></div>
      </div>
      <div class="concept-caption"><span class="concept-location">LONGCHAMPS · BUENOS AIRES</span>{variante !== 'tambor' && <span class="truck-services">HORMIGÓN <b>/</b> ACARREO <b>/</b> BOMBEO</span>}{<button type="button" data-motion-toggle aria-pressed="false">Pausar {variante === 'descarga' ? 'video' : 'rotación'}</button>}</div>
    </section>
</div>
<script>import '../../concepts.js';</script>
