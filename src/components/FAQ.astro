---
interface Item { question: string; answer: string; }
interface Props { items: Item[]; }
const { items } = Astro.props;
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};
---
<section class="faq-section section-shell" aria-labelledby="faq-title">
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema).replace(/</g, '\\u003c')} />
  <div class="section-heading" data-reveal>
    <p class="section-code">FAQ / CONSULTAS</p>
    <h2 id="faq-title">PREGUNTAS <em>FRECUENTES.</em></h2>
  </div>
  <div class="faq-list">
    {items.map((item) => (
      <details class="faq-item" data-reveal>
        <summary>{item.question}<i></i></summary>
        <p>{item.answer}</p>
      </details>
    ))}
  </div>
</section>
