---
import { Picture } from 'astro:assets';
interface Props { src: ImageMetadata; alt: string; class?: string; eager?: boolean; motion?: 'vertical' | 'horizontal' | 'flow'; }
const { src, alt, class: className = '', eager = false, motion = 'vertical' } = Astro.props;
---
<figure class:list={['image-reveal', `image-reveal--${motion}`, className]} data-reveal data-image-reveal>
  <Picture
    src={src}
    formats={['avif']}
    fallbackFormat="webp"
    widths={[640, 960, 1280, 1600, 1920]}
    sizes="(max-width: 760px) 100vw, 70vw"
    alt={alt}
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : 'auto'}
  />
</figure>
