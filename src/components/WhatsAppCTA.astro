---
import ArrowIcon from "./ArrowIcon.astro";
interface Props { label: string; message?: string; compact?: boolean; class?: string; }
const { label, message = 'Hola Redmix, quisiera solicitar un presupuesto.', compact = false, class: className = '' } = Astro.props;
const url = `https://wa.me/5491138245680?text=${encodeURIComponent(message)}`;
---
<a class:list={['technical-cta', 'technical-cta--solid', compact && 'technical-cta--compact', className]} href={url} target="_blank" rel="noopener noreferrer">
  <span>{label}</span>
  <ArrowIcon class="cta-arrow" />
  <i class="tick tick--a"></i><i class="tick tick--b"></i><i class="tick tick--c"></i><i class="tick tick--d"></i>
</a>
