---
import ArrowIcon from "./ArrowIcon.astro";
interface Props { label: string; message?: string; compact?: boolean; secondary?: boolean; icon?: boolean; class?: string; }
const { label, message = 'Hola Redmix, quisiera solicitar un presupuesto.', compact = false, secondary = false, icon = false, class: className = '' } = Astro.props;
const iconUrl = import.meta.env.BASE_URL + (import.meta.env.BASE_URL.endsWith('/') ? '' : '/') + 'images/whatsapp.svg';
const url = `https://wa.me/5491138245680?text=${encodeURIComponent(message)}`;
---
<a class:list={['technical-cta', !secondary && 'technical-cta--solid', compact && 'technical-cta--compact', className]} href={url} target="_blank" rel="noopener noreferrer">
  {icon && <img class="cta-whatsapp-icon" src={iconUrl} width="18" height="18" alt="" aria-hidden="true" />}
  <span>{label}</span>
  <ArrowIcon class="cta-arrow" />
  <i class="tick tick--a"></i><i class="tick tick--b"></i><i class="tick tick--c"></i><i class="tick tick--d"></i>
</a>
