---
const root = import.meta.env.BASE_URL.replace(/\/$/, '');
const message = 'Hola Redmix, quisiera solicitar un presupuesto.';
const url = `https://wa.me/5491138245680?text=${encodeURIComponent(message)}`;
---

<a class="floating-whatsapp" href={url} target="_blank" rel="noopener noreferrer" aria-label="Solicitar presupuesto por WhatsApp">
  <span class="floating-whatsapp__label">PEDIR PRESUPUESTO</span>
  <span class="floating-whatsapp__icon" aria-hidden="true">
    <img src={`${root}/images/whatsapp.svg`} width="36" height="36" alt="" />
  </span>
</a>
