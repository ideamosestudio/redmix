---
interface Props { idPrefix?: string; compact?: boolean; }
const { idPrefix = 'contact', compact = false } = Astro.props;
---
<form class:list={['contact-form', { 'contact-form--compact': compact }]} data-email-form data-reveal>
  <div class="contact-form__heading">
    <span>{compact ? 'FORM. 01 / CONSULTA' : 'FORMULARIO / CONTACTO'}</span>
    <strong>{compact ? 'CONTANOS SOBRE TU OBRA' : 'ENVIANOS TU CONSULTA'}</strong>
  </div>
  <div class="form-field">
    <label for={`${idPrefix}-name`}>Nombre</label>
    <input id={`${idPrefix}-name`} name="name" type="text" autocomplete="name" required />
  </div>
  <div class="form-field">
    <label for={`${idPrefix}-phone`}>Teléfono</label>
    <input id={`${idPrefix}-phone`} name="phone" type="tel" autocomplete="tel" required />
  </div>
  <div class="form-field">
    <label for={`${idPrefix}-message`}>Mensaje</label>
    <textarea id={`${idPrefix}-message`} name="message" rows={compact ? 4 : 6} required></textarea>
  </div>
  <button class="technical-cta technical-cta--solid" type="submit"><span>ENVIAR CONSULTA</span><i class="tick tick--a"></i><i class="tick tick--b"></i><i class="tick tick--c"></i><i class="tick tick--d"></i></button>
  <p class="form-note">Al enviar, se abrirá tu aplicación de correo con el mensaje preparado.</p>
</form>
