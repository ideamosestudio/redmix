---
import ArrowIcon from './ArrowIcon.astro';
const root = import.meta.env.BASE_URL.replace(/\/$/, '');
const steps = [
 {title:'SUMINISTRO',text:'Hormigón elaborado para las necesidades de tu proyecto.',href:'/servicios/hormigon-elaborado'},
 {title:'TRASLADO',text:'Coordinación del equipo de bombeo para llegar a tu obra.',href:'/servicios/acarreo-bomba'},
 {title:'BOMBEO',text:'Colocación del hormigón donde tu obra lo necesita.',href:'/servicios/bombeo-hormigon'}
];
---
<section class="work-sequence" aria-labelledby="process-title">
 <div class="work-sequence__heading" data-reveal><h3 id="process-title">DE LA MEZCLA<br /><em>A TU OBRA.</em></h3><p>Tres servicios.<br />Un mismo proveedor.</p></div>
 <div class="work-sequence__items">
  {steps.map(step => <a class="work-sequence__item" href={root + step.href}>
   <div><h4>{step.title}</h4><span class="work-sequence__arrow"><ArrowIcon /></span></div>
   <p>{step.text}</p>
  </a>)}
 </div>
</section>
