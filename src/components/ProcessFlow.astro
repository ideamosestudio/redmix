---
import ArrowIcon from './ArrowIcon.astro';
const root = import.meta.env.BASE_URL.replace(/\/$/, '');
const steps = [
 {title:'LA MEZCLA ADECUADA',text:'Hormigón según las necesidades de tu proyecto.',href:'/servicios/hormigon-elaborado'},
 {title:'ENTREGA COORDINADA',text:'Suministro y equipo coordinados para tu obra.',href:'/servicios/acarreo-bomba'},
 {title:'HORMIGÓN EN DESTINO',text:'Bombeo hasta el punto de colocación.',href:'/servicios/bombeo-hormigon'}
];
---
<section class="work-sequence" aria-labelledby="process-title">
 <div class="work-sequence__heading" data-reveal><h3 id="process-title">DE LA MEZCLA<br /><em>A TU OBRA.</em></h3><p>Suministro, logística y colocación.</p></div>
 <div class="work-sequence__items">
  {steps.map(step => <a class="work-sequence__item" href={root + step.href}>
   <div><h4>{step.title.split(" ").slice(0,-1).join(" ")} <span class="work-sequence__ending">{step.title.split(" ").at(-1)}<span class="work-sequence__arrow"><ArrowIcon /></span></span></h4></div>
   <p>{step.text}</p>
  </a>)}
 </div>
</section>
