---
import ArrowIcon from './ArrowIcon.astro';
const root = import.meta.env.BASE_URL.replace(/\/$/, '');
const steps = [
 {title:'LA MEZCLA ADECUADA',text:'Alternativas de hormigón según las necesidades de tu proyecto.',href:'/servicios/hormigon-elaborado'},
 {title:'ENTREGA COORDINADA',text:'Suministro y traslado del equipo coordinados para tu obra.',href:'/servicios/acarreo-bomba'},
 {title:'HORMIGÓN EN DESTINO',text:'Bombeo para llevar el hormigón al punto de colocación.',href:'/servicios/bombeo-hormigon'}
];
---
<section class="work-sequence" aria-labelledby="process-title">
 <div class="work-sequence__heading" data-reveal><h3 id="process-title">DE LA MEZCLA<br /><em>A TU OBRA.</em></h3><p>Tu obra, de principio a fin.<br />Un mismo proveedor.</p></div>
 <div class="work-sequence__items">
  {steps.map(step => <a class="work-sequence__item" href={root + step.href}>
   <div><h4>{step.title}</h4><span class="work-sequence__arrow"><ArrowIcon /></span></div>
   <p>{step.text}</p>
  </a>)}
 </div>
</section>
