---
import { Picture } from 'astro:assets';
import WhatsAppCTA from './WhatsAppCTA.astro';
interface Props { index: string; title: string; description: string; href: string; image: ImageMetadata; imageAlt: string; }
const { index, title, description, href, image, imageAlt } = Astro.props;
---
<article class="service-card" data-card>
  <a class="service-card__image" href={href} aria-label={`Conocé ${title}`}>
    <Picture src={image} formats={['avif']} fallbackFormat="webp" widths={[480, 720, 960]} sizes="(max-width: 760px) 100vw, 33vw" alt={imageAlt} loading="lazy" />
    <span>{index}</span>
  </a>
  <div class="service-card__body">
    <h3><a href={href}>{title}</a></h3>
    <p>{description}</p>
    <div class="service-card__actions">
      <a class="text-link" href={href}>CONOCÉ EL SERVICIO</a>
      <WhatsAppCTA label="PEDIR PRESUPUESTO" compact />
    </div>
  </div>
</article>
