---
import { Picture } from 'astro:assets';
import WhatsAppCTA from './WhatsAppCTA.astro';
interface Props { index: string; title: string; description: string; href: string; image: ImageMetadata; imageAlt: string; }
const { index, title, description, href, image, imageAlt } = Astro.props;
---
<article class="service-card" data-card>
  <a class="service-card__image" href={href} aria-label={`Conocé ${title}`}>
    <Picture src={image} formats={['avif']} fallbackFormat="webp" widths={[480, 720, 960]} sizes="(max-width: 767px) 100vw, (max-width: 1199px) 47vw, 33vw" alt={imageAlt} loading="lazy" />
    <span>{index}</span>
  </a>
  <div class="service-card__body">
    <div class="service-card__meta"><span>RMX / SERVICIO</span><b>{index}</b></div>
    <h3><a href={href}>{title}</a></h3>
    <p>{description}</p>
    <div class="service-card__actions">
      <a class="technical-cta technical-cta--compact" href={href}>
        <span>VER MÁS</span><i class="cta-arrow" aria-hidden="true">→</i>
        <i class="tick tick--a"></i><i class="tick tick--b"></i><i class="tick tick--c"></i><i class="tick tick--d"></i>
      </a>
      <WhatsAppCTA label="PEDÍ TU PRESUPUESTO" compact />
    </div>
  </div>
</article>
